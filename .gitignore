-- =========================================================================
-- DOORS CLASSIC MODE v1.2 - RESTORED FULL HOLD LOGIC + FIXES
-- =========================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
local camera = Workspace.CurrentCamera

-------------------------------------------------------------------------
-- PHẦN 0: BẢNG CẢNH BÁO CLASSIC MODE v1.2
-------------------------------------------------------------------------

local function createWarningUI()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ClassicModeWarning"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 99999
	screenGui.Parent = playerGui

	local background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
	background.BackgroundTransparency = 0.15
	background.Parent = screenGui

	local mainFrame = Instance.new("Frame")
	mainFrame.Size = UDim2.new(0, 480, 0, 260)
	mainFrame.Position = UDim2.new(0.5, -240, 0.5, -130)
	mainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	mainFrame.BorderSizePixel = 0
	mainFrame.Parent = background

	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(150, 20, 20)
	uiStroke.Thickness = 2
	uiStroke.Parent = mainFrame

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 8)
	uiCorner.Parent = mainFrame

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -40, 0, 50)
	titleLabel.Position = UDim2.new(0, 20, 0, 15)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "⚠️ WARNING: CLASSIC MODE v1.2"
	titleLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
	titleLabel.TextSize = 22
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = mainFrame

	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(1, -40, 0, 100)
	descLabel.Position = UDim2.new(0, 20, 0, 65)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = "• Classic Mode is designed exclusively for the official DOORS game by Lsplash.\n\n• Individuals with a history of headaches, motion sickness, dizziness, or weak hearts are strongly advised NOT to play."
	descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	descLabel.TextSize = 14
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextWrapped = true
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.TextYAlignment = Enum.TextYAlignment.Top
	descLabel.Parent = mainFrame

	local understoodBtn = Instance.new("TextButton")
	understoodBtn.Size = UDim2.new(1, -40, 0, 45)
	understoodBtn.Position = UDim2.new(0, 20, 1, -60)
	understoodBtn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
	understoodBtn.BorderSizePixel = 0
	understoodBtn.Text = "I Understand"
	understoodBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	understoodBtn.TextSize = 16
	understoodBtn.Font = Enum.Font.GothamBold
	understoodBtn.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = understoodBtn

	understoodBtn.MouseButton1Click:Connect(function()
		local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		TweenService:Create(background, tweenInfo, {BackgroundTransparency = 1}):Play()
		TweenService:Create(mainFrame, tweenInfo, {BackgroundTransparency = 1}):Play()
		task.delay(0.5, function() screenGui:Destroy() end)
	end)
end

createWarningUI()

-------------------------------------------------------------------------
-- PHẦN 1: ĐỒ HỌA U ÁM X10 & CINEMA CỔ ĐIỂN
-------------------------------------------------------------------------

Lighting.Technology = Enum.Technology.Future
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.01

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
atmosphere.Density = 0.52
atmosphere.Offset = 0.28
atmosphere.Color = Color3.fromRGB(12, 14, 18)
atmosphere.Decay = Color3.fromRGB(3, 3, 6)

local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
bloom.Intensity = 0.75
bloom.Size = 26
bloom.Threshold = 0.6

local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect") or Instance.new("DepthOfFieldEffect", Lighting)
dof.FarIntensity = 0.5
dof.FocusDistance = 8
dof.InFocusRadius = 4
dof.NearIntensity = 0.3

local colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect", Lighting)
colorCorrection.Brightness = -0.05
colorCorrection.Contrast = 0.45
colorCorrection.Saturation = -0.42

-------------------------------------------------------------------------
-- PHẦN 2: SUBTITLE SYSTEM (XÍT NẰM TRÊN THANH HOTBAR)
-------------------------------------------------------------------------

local function showSubtitle(text)
	task.spawn(function()
		local subGui = playerGui:FindFirstChild("SubtitleGui") or Instance.new("ScreenGui")
		subGui.Name = "SubtitleGui"
		subGui.Parent = playerGui

		local label = subGui:FindFirstChild("SubLabel") or Instance.new("TextLabel")
		label.Name = "SubLabel"
		label.Size = UDim2.new(1, 0, 0, 40)
		label.Position = UDim2.new(0, 0, 0.72, 0) -- Đẩy vị trí lên trên Hotbar
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = Color3.fromRGB(255, 70, 70)
		label.TextSize = 21
		label.Font = Enum.Font.SpecialElite
		label.TextStrokeTransparency = 0.5
		label.Parent = subGui

		task.wait(2.5)
		if label.Text == text then
			label.Text = ""
		end
	end)
end

-------------------------------------------------------------------------
-- PHẦN 3: DYNAMIC CAMERA & MÁU HP MECHANICS
-------------------------------------------------------------------------

local bobbingSpeed = 9
local bobbingAmount = 0.04
local tiltAmount = 0.03

RunService.RenderStepped:Connect(function(deltaTime)
	if not character or not humanoid or humanoid.Health <= 0 then return end
	
	local velocity = rootPart.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	
	if speed > 1 then
		local currentTime = tick()
		local bobX = math.cos(currentTime * bobbingSpeed) * bobbingAmount
		local bobY = math.abs(math.sin(currentTime * bobbingSpeed)) * bobbingAmount
		camera.CFrame = camera.CFrame * CFrame.new(bobX, bobY, 0)
	end
	
	local localVelocity = camera.CFrame:VectorToObjectSpace(velocity)
	local roll = math.clamp(-localVelocity.X * tiltAmount, -0.04, 0.04)
	camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, roll)
end)

local heartbeatSound = Instance.new("Sound", camera)
heartbeatSound.SoundId = "rbxassetid://9114223179"
heartbeatSound.Volume = 0
heartbeatSound.Looped = true
heartbeatSound:Play()

local hasWarnedExhausted = false

humanoid.HealthChanged:Connect(function(health)
	if health <= 75 and not hasWarnedExhausted then
		hasWarnedExhausted = true
		showSubtitle("I feel exhausted...")
	elseif health > 75 then
		hasWarnedExhausted = false
	end

	if health < 40 then
		local targetVolume = (40 - health) / 30
		TweenService:Create(heartbeatSound, TweenInfo.new(1), {Volume = math.clamp(targetVolume, 0.2, 1)}):Play()
	else
		TweenService:Create(heartbeatSound, TweenInfo.new(1), {Volume = 0}):Play()
	end
end)

-------------------------------------------------------------------------
-- PHẦN 4: CHỚP ĐÈN KÈM ÂM THANH ĐIỆN CỔ ĐIỂN
-------------------------------------------------------------------------

local function applyDoorReverb(sound)
	if sound:IsA("Sound") and (sound.Name:lower():find("door") or sound.SoundId:find("9114")) then
		if not sound:FindFirstChildOfClass("ReverbSoundEffect") then
			local reverb = Instance.new("ReverbSoundEffect")
			reverb.Density = 0.85
			reverb.Diffusion = 0.9
			reverb.DecayTime = 2.0
			reverb.DryLevel = -1
			reverb.WetLevel = 3.5
			reverb.Parent = sound
		end
	end
end

Workspace.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("Sound") then applyDoorReverb(descendant) end
end)

for _, sound in ipairs(Workspace:GetDescendants()) do
	if sound:IsA("Sound") then applyDoorReverb(sound) end
end

local function flickerLightsWithCustomSound()
	task.spawn(function()
		local zapSound = Instance.new("Sound", camera)
		zapSound.SoundId = "rbxassetid://9114223303"
		zapSound.Volume = 0.85
		zapSound.PlaybackSpeed = 0.9
		zapSound:Play()
		zapSound.Ended:Connect(function() zapSound:Destroy() end)

		for i = 1, 10 do
			for _, light in ipairs(Workspace:GetDescendants()) do
				if light:IsA("Light") then
					light.Enabled = not light.Enabled
				end
			end
			task.wait(math.random(5, 11) / 100)
		end
		for _, light in ipairs(Workspace:GetDescendants()) do
			if light:IsA("Light") then light.Enabled = true end
		end
	end)
end

Workspace.ChildAdded:Connect(function(child)
	local name = child.Name
	if name == "RushMoving" or name == "AmbushMoving" or name == "SeekMoving" or name == "Eyes" then
		flickerLightsWithCustomSound()
		
		local monsterSound = Instance.new("Sound", rootPart)
		monsterSound.SoundId = "rbxassetid://9114251025"
		monsterSound.Volume = 0.85
		monsterSound:Play()
		monsterSound.Ended:Connect(function() monsterSound:Destroy() end)
	end
end)

-------------------------------------------------------------------------
-- PHẦN 5: KHÔI PHỤC TOÀN BỘ LOGIC GIỮ NÚT CỦA SCRIPT CŨ
-------------------------------------------------------------------------

local function applyHoldDuration(prompt)
	if not prompt:IsA("ProximityPrompt") then return end
	
	local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
	local grandparentName = prompt.Parent and prompt.Parent.Parent and prompt.Parent.Parent.Name:lower() or ""
	local actionText = prompt.ActionText:lower()
	local objectText = prompt.ObjectText:lower()

	local isCloset = parentName:find("closet") or parentName:find("wardrobe") or parentName:find("bed") or actionText:find("hide") or objectText:find("hide") or grandparentName:find("closet")
	local isDrawer = parentName:find("drawer") or parentName:find("chest") or parentName:find("cabinet") or (actionText:find("open") and not parentName:find("door"))
	local isLockedDoor = actionText:find("unlock") or actionText:find("key") or objectText:find("lock") or prompt.Parent:FindFirstChild("Lock") ~= nil

	-- LOGIC THỜI GIAN VÀ NHÃN [GIỮ] CỦA SCRIPT CŨ:
	if isLockedDoor then
		prompt.HoldDuration = 5.0 -- Ổ khóa giữ 5.0s
		prompt.ActionText = "Mở khóa [Giữ]"
	elseif isDrawer then
		prompt.HoldDuration = 0.2 -- Hộc tủ giữ 0.2s
		prompt.ActionText = "Mở tủ [Giữ]"
	elseif isCloset then
		prompt.HoldDuration = 1.0 -- Tủ trốn giữ 1.0s
		prompt.ActionText = "Trốn vào [Giữ]"
	else
		-- Tất cả các tương tác/nhặt đồ khác giữ nguyên logic phải Giữ nút
		if prompt.HoldDuration < 0.4 then
			prompt.HoldDuration = 0.5
		end
		if not prompt.ActionText:find("%[Giữ%]") then
			if prompt.ActionText == "" or prompt.ActionText:lower() == "interact" then
				prompt.ActionText = "Nhặt [Giữ]"
			else
				prompt.ActionText = prompt.ActionText .. " [Giữ]"
			end
		end
	end

	-- Dưới 25 HP: Chặn mở HỘP TỦ (Drawer)
	prompt.PromptButtonHoldBegan:Connect(function(player)
		if player ~= localPlayer then return end
		local currentHP = humanoid.Health
		
		if isDrawer and currentHP < 25 then
			prompt.Enabled = false
			task.delay(0.2, function() prompt.Enabled = true end)
			showSubtitle("I don't have enough strength to open it")
		end
	end)
end

for _, prompt in ipairs(Workspace:GetDescendants()) do
	if prompt:IsA("ProximityPrompt") then applyHoldDuration(prompt) end
end

Workspace.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("ProximityPrompt") then
		task.wait(0.05)
		applyHoldDuration(descendant)
	end
end)

print("[DOORS] Classic Mode v1.2 (Old Hold Logic Completely Restored!)")
