-- =========================================================================
-- DOORS SUPREME REALISM, MAX GRAPHICS & CLASSIC MODE WARNING UI (FULL CODE)
-- Đặt script này vào StarterPlayer -> StarterPlayerScripts (hoặc chạy qua Executor)
-- =========================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-------------------------------------------------------------------------
-- PHẦN 0: HIỆN BẢNG CẢNH BÁO CLASSIC MODE (ENGLISH WARNING UI)
-------------------------------------------------------------------------

local function createWarningUI()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ClassicModeWarning"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 99999
	screenGui.Parent = playerGui

	-- Khung nền mờ toàn màn hình (Dark Blur Background)
	local background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
	background.BackgroundTransparency = 0.2
	background.Parent = screenGui

	-- Khung thông báo chính (Modal Box)
	local mainFrame = Instance.new("Frame")
	mainFrame.Size = UDim2.new(0, 480, 0, 260)
	mainFrame.Position = UDim2.new(0.5, -240, 0.5, -130)
	mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	mainFrame.BorderSizePixel = 0
	mainFrame.Parent = background

	-- Viền đỏ kinh dị nhẹ nhàng
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(120, 20, 20)
	uiStroke.Thickness = 2
	uiStroke.Parent = mainFrame

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 8)
	uiCorner.Parent = mainFrame

	-- Tiêu đề cảnh báo (WARNING TITLE)
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -40, 0, 50)
	titleLabel.Position = UDim2.new(0, 20, 0, 15)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "⚠️ WARNING: CLASSIC MODE"
	titleLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
	titleLabel.TextSize = 22
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = mainFrame

	-- Nội dung cảnh báo (ENGLISH MESSAGE)
	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(1, -40, 0, 100)
	descLabel.Position = UDim2.new(0, 20, 0, 65)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = "• Classic Mode is designed exclusively for the official DOORS game by Lsplash.\n\n• Individuals with a history of headaches, motion sickness, dizziness, or weak hearts are strongly advised NOT to play."
	descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	descLabel.TextSize = 14
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextWrapped = true
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.TextYAlignment = Enum.TextYAlignment.Top
	descLabel.Parent = mainFrame

	-- Nút bấm "I Understand" (Đã hiểu)
	local understoodBtn = Instance.new("TextButton")
	understoodBtn.Size = UDim2.new(1, -40, 0, 45)
	understoodBtn.Position = UDim2.new(0, 20, 1, -60)
	understoodBtn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
	understoodBtn.BorderSizePixel = 0
	understoodBtn.Text = "I Understand"
	understoodBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	understoodBtn.TextSize = 16
	understoodBtn.Font = Enum.Font.GothamBold
	understoodBtn.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = understoodBtn

	-- Hiệu ứng khi bấm nút
	understoodBtn.MouseButton1Click:Connect(function()
		-- Hiệu ứng mờ dần rồi tắt bảng cảnh báo
		local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		TweenService:Create(background, tweenInfo, {BackgroundTransparency = 1}):Play()
		TweenService:Create(mainFrame, tweenInfo, {BackgroundTransparency = 1}):Play()
		
		task.delay(0.5, function()
			screenGui:Destroy()
		end)
	end)
end

createWarningUI()

-------------------------------------------------------------------------
-- PHẦN 1: NÂNG CẤP ĐỒ HỌA MAX GRAPHICS (SUPREME FUTURE LIGHTING)
-------------------------------------------------------------------------

Lighting.Technology = Enum.Technology.Future
Lighting.GlobalShadows = true
Lighting.ShadowSoftness = 0.01

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
atmosphere.Density = 0.5
atmosphere.Offset = 0.35
atmosphere.Color = Color3.fromRGB(18, 22, 28)
atmosphere.Decay = Color3.fromRGB(4, 4, 8)

local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect", Lighting)
sunRays.Intensity = 0.35
sunRays.Spread = 0.9

local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
bloom.Intensity = 0.85
bloom.Size = 40
bloom.Threshold = 0.6

local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect") or Instance.new("DepthOfFieldEffect", Lighting)
dof.FarIntensity = 0.5
dof.FocusDistance = 8
dof.InFocusRadius = 4
dof.NearIntensity = 0.35

local colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect", Lighting)
colorCorrection.Brightness = -0.15
colorCorrection.Contrast = 0.35
colorCorrection.Saturation = -0.4

local motionBlur = Lighting:FindFirstChildOfClass("BlurEffect") or Instance.new("BlurEffect", Lighting)
motionBlur.Name = "MotionBlurEffect"
motionBlur.Size = 0

local camera = Workspace.CurrentCamera
local lastCameraCFrame = camera.CFrame
RunService.RenderStepped:Connect(function()
	local delta = (camera.CFrame.LookVector - lastCameraCFrame.LookVector).Magnitude
	motionBlur.Size = math.clamp(delta * 14, 0, 7)
	lastCameraCFrame = camera.CFrame
end)

-------------------------------------------------------------------------
-- PHẦN 2: DYNAMIC CAMERA BOBBING & LOW HEALTH EFFECTS
-------------------------------------------------------------------------

local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local bobbingSpeed = 9
local bobbingAmount = 0.06
local tiltAmount = 0.04

RunService.RenderStepped:Connect(function(deltaTime)
	if not character or not humanoid or humanoid.Health <= 0 then return end
	
	local velocity = rootPart.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	
	if speed > 1 then
		local currentTime = tick()
		local bobX = math.cos(currentTime * bobbingSpeed) * bobbingAmount
		local bobY = math.abs(math.sin(currentTime * bobbingSpeed)) * bobbingAmount
		camera.CFrame = camera.CFrame * CFrame.new(bobX, bobY, 0)
	end
	
	local localVelocity = camera.CFrame:VectorToObjectSpace(velocity)
	local roll = math.clamp(-localVelocity.X * tiltAmount, -0.05, 0.05)
	camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, roll)
end)

local heartbeatSound = Instance.new("Sound", camera)
heartbeatSound.SoundId = "rbxassetid://9114223179"
heartbeatSound.Volume = 0
heartbeatSound.Looped = true
heartbeatSound:Play()

humanoid.HealthChanged:Connect(function(health)
	if health < 40 then
		local targetVolume = (40 - health) / 30
		TweenService:Create(heartbeatSound, TweenInfo.new(1), {Volume = math.clamp(targetVolume, 0.2, 1)}):Play()
		colorCorrection.TintColor = Color3.fromRGB(255, 160, 160)
	else
		TweenService:Create(heartbeatSound, TweenInfo.new(1), {Volume = 0}):Play()
		colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
	end
end)

-------------------------------------------------------------------------
-- PHẦN 3: HIỆU ỨNG THỰC THỂ & ĐÈN CHỚP
-------------------------------------------------------------------------

local function flickerLights()
	task.spawn(function()
		for i = 1, 10 do
			for _, light in ipairs(Workspace:GetDescendants()) do
				if light:IsA("Light") then
					light.Enabled = not light.Enabled
				end
			end
			task.wait(math.random(5, 12) / 100)
		end
		for _, light in ipairs(Workspace:GetDescendants()) do
			if light:IsA("Light") then light.Enabled = true end
		end
	end)
end

Workspace.ChildAdded:Connect(function(child)
	local name = child.Name
	if name == "RushMoving" or name == "AmbushMoving" or name == "Eyes" or name == "SeekMoving" then
		flickerLights()
		
		local monsterSound = Instance.new("Sound", rootPart)
		monsterSound.SoundId = "rbxassetid://9114251025"
		monsterSound.Volume = 0.9
		monsterSound:Play()
		monsterSound.Ended:Connect(function() monsterSound:Destroy() end)
	end
	
	task.spawn(function()
		local entityNames = {"RushMoving", "AmbushMoving", "SeekMoving", "Eyes", "Snare", "Glitch", "Figure"}
		for _, eName in ipairs(entityNames) do
			if name == eName or name:find("Entity") then
				local pLight = Instance.new("PointLight")
				pLight.Color = Color3.fromRGB(255, 20, 20)
				pLight.Range = 30
				pLight.Brightness = 7
				pLight.Parent = child:FindFirstChild("HumanoidRootPart") or child
				
				local highlight = Instance.new("Highlight")
				highlight.FillColor = Color3.fromRGB(160, 0, 0)
				highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				highlight.FillTransparency = 0.3
				highlight.Parent = child
				break
			end
		end
	end)
end)

-------------------------------------------------------------------------
-- PHẦN 4: HỆ THỐNG GIỮ NÚT TƯƠNG TÁC HARDCORE
-------------------------------------------------------------------------

local function applyHoldDuration(prompt)
	if not prompt:IsA("ProximityPrompt") then return end
	
	local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
	local grandparentName = prompt.Parent and prompt.Parent.Parent and prompt.Parent.Parent.Name:lower() or ""
	local actionText = prompt.ActionText:lower()
	local objectText = prompt.ObjectText:lower()

	if parentName:find("closet") or parentName:find("wardrobe") or parentName:find("bed") or actionText:find("hide") or objectText:find("hide") or grandparentName:find("closet") then
		prompt.HoldDuration = 1.5
		prompt.ActionText = "Trốn vào [Giữ]"
	elseif parentName:find("drawer") or parentName:find("chest") or parentName:find("cabinet") or (actionText:find("open") and not parentName:find("door")) then
		prompt.HoldDuration = 1.0
		prompt.ActionText = "Mở tủ [Giữ]"
	elseif parentName:find("gold") or actionText:find("gold") or objectText:find("gold") then
		prompt.HoldDuration = 0.3
		prompt.ActionText = "Nhặt vàng [Giữ]"
	else
		prompt.HoldDuration = 0.5
		if actionText == "" or actionText == "interact" then
			prompt.ActionText = "Nhặt [Giữ]"
		else
			prompt.ActionText = prompt.ActionText .. " [Giữ]"
		end
	end
end

for _, prompt in ipairs(Workspace:GetDescendants()) do
	if prompt:IsA("ProximityPrompt") then
		applyHoldDuration(prompt)
	end
end

Workspace.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("ProximityPrompt") then
		task.wait(0.05)
		applyHoldDuration(descendant)
	end
end)

-------------------------------------------------------------------------
-- PHẦN 5: GUIDING LIGHT CUSTOM DIALOGUES (ENGLISH DEATH MESSAGES)
-------------------------------------------------------------------------

humanoid.Died:Connect(function()
	task.wait(1.5)
	
	local backpack = localPlayer:FindFirstChild("Backpack")
	local hasCrucifix = false
	
	if (backpack and backpack:FindFirstChild("Crucifix")) or (character and character:FindFirstChild("Crucifix")) then
		hasCrucifix = true
	end
	
	local killedByRush = false
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "RushMoving" or obj.Name == "Rush" then
			killedByRush = true
			break
		end
	end
	
	local customMessages = {}
	
	if hasCrucifix then
		customMessages = {
			"Is that Crucifix in your pocket just for decoration?",
			"Be a bit smarter next time, my friend.",
			"At least put your life above everything else!"
		}
	elseif killedByRush then
		customMessages = {
			"It seems like you were killed by Rush.",
			"Pay attention, the flickering lights in the room are your warning signal.",
			"Look for nearby hiding spots to evade Rush!",
			"See you again!"
		}
	end

	if #customMessages > 0 then
		task.spawn(function()
			local deathGui = playerGui:FindFirstChild("Death") or playerGui:FindFirstChild("GuidingLight")
			if deathGui then
				local titleLabel = deathGui:FindFirstChild("Title", true) or deathGui:FindFirstChild("TextLabel", true)
				if titleLabel and titleLabel:IsA("TextLabel") then
					for _, msg in ipairs(customMessages) do
						titleLabel.Text = msg
						task.wait(3.5)
					end
				end
			end
		end)
	end
end)

print("[DOORS] Classic Mode Warning & Supreme Realism Fully Loaded!")
